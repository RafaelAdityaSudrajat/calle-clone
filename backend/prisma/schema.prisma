generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================================
// ENUM
// ================================================

enum Role {
  BUYER
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CartStatus {
  ACTIVE
  CHECKOUT_IN_PROGRESS
}

enum AuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED

  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_SUCCESS
  PASSWORD_CHANGED

  LOGOUT
  LOGOUT_ALL

  REFRESH_TOKEN_REUSE_DETECTED

  ADMIN_FORCE_RESET
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model User {
  id String @id @default(uuid())

  // BR-22: Email unique & case-insensitive (pastikan lowercase sebelum save/query di service layer)
  email String @unique

  // BR-04: Password wajib di-hash (bcrypt/argon2) & tidak boleh plaintext
  passwordHash String

  // BR-02: Default role BUYER
  role Role @default(BUYER)

  // BR-03: Default status UNVERIFIED saat register
  status AccountStatus @default(UNVERIFIED)

  // Digunakan untuk invalidate seluruh access token user.
  sessionVersion Int @default(0)

  cart Cart?

  orders Order[]

  // BR-29: Rate limiting login (max 5 gagal dalam 15 menit)
  failedLoginAttempts    Int       @default(0)
  failedLoginWindowStart DateTime?
  lockoutUntil           DateTime?

  // BR-05 & BR-30: Token verifikasi email (single-use & expired 24 jam)
  emailVerifyTokenHash String?   @unique
  emailVerifyExpires   DateTime?

  // BR-15 & BR-30: Token reset password (single-use & expired 15-30 menit)
  resetPasswordTokenHash String?   @unique
  resetPasswordExpires   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: 1 User bisa punya banyak Refresh Token (Multi-device login)
  refreshTokens RefreshToken[]

  productsCreated     Product[]        @relation("ProductCreatedBy")
  productsUpdated     Product[]        @relation("ProductUpdatedBy")
  variantsCreated     ProductVariant[] @relation("VariantCreatedBy")
  variantsUpdated     ProductVariant[] @relation("VariantUpdatedBy")
  imagesCreated       ProductImage[]   @relation("ImageCreatedBy")
  auditEventsAsActor  AuditLog[]       @relation("AuditActor")
  auditEventsAsTarget AuditLog[]       @relation("AuditTarget")
}

model RefreshToken {
  id String @id @default(uuid())

  // Menyimpan hash dari refresh token, bukan plaintext-nya, demi keamanan ekstra
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // BR-27: Auto-expire ±7 hari
  expiresAt DateTime

  // --- FIELD KHUSUS ROTATION & REUSE DETECTION (BR-27 & BR-28) ---
  // Jika null = token aktif. Jika terisi = token sudah di-rotate / dicabut
  revokedAt DateTime?

  // Menyimpan tokenHash baru yang menggantikan token ini (chaining)
  replacedByToken String?
  // ---------------------------------------------------------------

  // Metadata untuk audit log & manajemen sesi device (Opsional tapi recommended)
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  // Index untuk mempercepat query pengecekan validitas token & cleanup cron job
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(uuid())

  event AuditEvent

  actorUserId  String?
  targetUserId String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([event, createdAt])
}

model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Product {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(200)
  description String?       @db.Text
  // Nullable di DB supaya DRAFT boleh belum punya kategori (dicek saat publish: CATEGORY_REQUIRED)
  categoryId  String?       @map("category_id")
  status      ProductStatus @default(DRAFT)
  deletedAt   DateTime?     @map("deleted_at")
  createdBy   String        @map("created_by")
  updatedBy   String        @map("updated_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator  User             @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  updater  User             @relation("ProductUpdatedBy", fields: [updatedBy], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([status, deletedAt]) // query katalog buyer
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String   @db.VarChar(500)
  fileKey   String   @map("file_key") @db.VarChar(500) // key storage (S3) untuk delete
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator User    @relation("ImageCreatedBy", fields: [createdBy], references: [id])

  @@index([productId])
}

model ProductVariant {
  id        String      @id @default(uuid())
  productId String      @map("product_id")
  sku       String      @unique @db.VarChar(100) // global unique, termasuk yang soft-deleted
  size      String?     @db.VarChar(20)
  color     String?     @db.VarChar(50)
  price     Decimal     @db.Decimal(12, 2)
  stock     Int         @default(0) // CHECK (stock >= 0) di SQL
  deletedAt DateTime?   @map("deleted_at")
  createdBy String      @map("created_by")
  updatedBy String      @map("updated_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  cartItem  CartItem[]
  orderItem OrderItem[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator User    @relation("VariantCreatedBy", fields: [createdBy], references: [id])
  updater User    @relation("VariantUpdatedBy", fields: [updatedBy], references: [id])

  @@index([productId, deletedAt]) // list varian aktif per produk
  @@index([stock]) // low-stock list
}

model Cart {
  id String @id @default(uuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status CartStatus @default(ACTIVE)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  quantity Int

  // Snapshot harga saat pertama ditambahkan. Bukan source of truth.
  // Dipakai untuk deteksi perubahan harga (BR-13, DD-08).
  priceAtAdd Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
}

model Order {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(UNPAID)

  totalAmount Decimal @db.Decimal(12, 2)

  paidAt DateTime?

  // Snapshot alamat (DD-05)
  shippingRecipientName String
  shippingPhone         String
  shippingAddressLine   String
  shippingCity          String
  shippingPostalCode    String

  // Idempotency (DD-11)
  idempotencyKey String

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, status, createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  // Snapshot (DD-06)
  productName String
  variantSku  String

  // Freeze harga (BR-14, DD-02)
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  subtotal  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productVariantId])
}
